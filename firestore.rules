// Reference copy of the rules published in Firebase Console -> Firestore -> Rules.
// Editing this file does NOT change the live rules; paste changes into the console and Publish.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [ 'GhU1pJNsytTivKochaskPgO4Fiy1' ];
    }
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /slugs/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
